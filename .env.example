# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 .gitignore 에 등록되어 있다.
# 키 값은 코드·노트북·스크린샷·리포트 어디에도 노출하지 않는다 (가이드 4-1).

# --- 필수 ---
OPENAI_API_KEY=

# --- 모델 (교육 과정 안내에 따라 변경) ---
OPENAI_CHAT_MODEL=gpt-4o-mini
# 임베딩 모델을 바꾸면 인덱스 전체를 재구축해야 한다 (가이드 4-5)
EMBEDDING_MODEL=text-embedding-3-small

# --- 벡터 DB ---
# 챗봇이 조회할 Chroma 컬렉션. `python -m indexer build --chunk-config <name>` 은
# docs__<name> 컬렉션을 만든다. 청킹 실험 비교 후 최종 선택한 컬렉션을 지정한다.
CHROMA_COLLECTION=docs__c500

# --- RAG 체인 ---
# 답변 근거로 넣을 검색 결과 수
RAG_TOP_K=5
# 이 코사인 유사도 미만인 검색 결과는 근거로 쓰지 않는다. 모두 미만이면 LLM 호출 없이 거절한다.
# 평가 결과(summary.json 의 1위 유사도 분포)로 정했다: 답변 가능 문항 최저 0.570, 답변 불가 0.447~0.681.
# 0.5 는 답변 가능 문항을 하나도 거절하지 않으면서 답변 불가 2문항을 검색 단계에서 거절한다.
RAG_MIN_SCORE=0.5
# 검색 방식: vector (의미 검색) | hybrid (의미 검색 + 키워드 BM25, RRF 결합).
# hybrid 는 indexer prepare 가 만든 키워드 색인을 쓴다. 평가셋 v1.2 기준 Hit@3 0.667 → 0.917 로 hybrid 선택.
RAG_RETRIEVAL_MODE=hybrid
# 답변 근거로 넣는 문서당 청크 수 (1~3). 검색 순위는 그대로이고 같은 기사의 세부 내용을 더 넣는다.
# 답변 채점 결과 2 가 정답률 50% → 58%, 출처 정확도 86% → 95% 로 2 선택.
RAG_CONTEXT_CHUNKS=2

# --- 크롤링 ---
# 요청 간 최소 딜레이(초). 1.0 미만은 허용하지 않는다.
CRAWL_DELAY_SEC=1.5
CRAWLER_USER_AGENT=mini-project3-edu-crawler/0.1

# --- 직접 수집용 API 키 (사용하는 것만 채운다) ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_REST_API_KEY=
DATA_GO_KR_SERVICE_KEY=
# 주제 B (산업·기술 동향) 선택 시
DART_API_KEY=
