# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 .gitignore 에 등록되어 있다.
# 키 값은 코드·노트북·스크린샷·리포트 어디에도 노출하지 않는다 (가이드 4-1).

# --- 필수 ---
OPENAI_API_KEY=

# --- 모델 (교육 과정 안내에 따라 변경) ---
OPENAI_CHAT_MODEL=gpt-4o-mini
# 임베딩 모델을 바꾸면 인덱스 전체를 재구축해야 한다 (가이드 4-5)
EMBEDDING_MODEL=text-embedding-3-small

# --- 벡터 DB ---
# 챗봇이 조회할 Chroma 컬렉션. `python -m indexer build --chunk-config <name>` 은
# docs__<name> 컬렉션을 만든다. 청킹 실험 비교 후 최종 선택한 컬렉션을 지정한다.
CHROMA_COLLECTION=docs__baseline

# --- 크롤링 ---
# 요청 간 최소 딜레이(초). 1.0 미만은 허용하지 않는다.
CRAWL_DELAY_SEC=1.5
CRAWLER_USER_AGENT=mini-project3-edu-crawler/0.1

# --- 직접 수집용 API 키 (사용하는 것만 채운다) ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_REST_API_KEY=
DATA_GO_KR_SERVICE_KEY=
# 주제 B (산업·기술 동향) 선택 시
DART_API_KEY=
